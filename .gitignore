# ==========================================
# 1. Environment Variables & Secrets (CRITICAL)
# ==========================================
# Ignores any .env file in any folder (backend, frontend-client, frontend-admin, etc.)
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# ==========================================
# 2. Dependency Folders
# ==========================================
**/node_modules/

# ==========================================
# 3. Build & Output Directories
# ==========================================
**/build/
**/dist/
**/out/
.next/

# ==========================================
# 4. Logs & Debugging
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ==========================================
# 5. OS & IDE Junk Files
# ==========================================
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

# ==========================================
# 6. Uploaded Media (Local Storage fallback)
# ==========================================
# If you store receipt uploads locally during dev before Cloudinary setup
**/uploads/*
!**/uploads/.gitkeep