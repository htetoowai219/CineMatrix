# ── Required ──────────────────────────────────────────────
PORT=8000
FRONTEND_CLIENT=https://your-client.vercel.app
FRONTEND_ADMIN=https://your-admin.vercel.app
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/cinematrix
REDIS_URL=redis://<host>:<port>
ACCESS_TOKEN_SECRET=<random-secret>
ACCESS_TOKEN_EXP=1d
REFRESH_TOKEN_SECRET=<random-secret>
REFRESH_TOKEN_EXP=7d
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>

# ── Optional ──────────────────────────────────────────────
PENDING_BOOKING_TTL_MINUTES=30
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=CineMatrix <no-reply@yourdomain.com>
