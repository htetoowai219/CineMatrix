# ── Required ──────────────────────────────────────────────
# These are local-development defaults. docker-compose.yaml overrides
# MONGO_URI, REDIS_URL, FRONTEND_CLIENT and FRONTEND_ADMIN with the Compose
# service hostnames when the backend runs in a container.
PORT=8000
FRONTEND_CLIENT=http://localhost:5173
FRONTEND_ADMIN=http://localhost:5174
MONGO_URI=mongodb://localhost:27017/cinematrix
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=<random-secret>
ACCESS_TOKEN_EXP=1d
REFRESH_TOKEN_SECRET=<random-secret>
REFRESH_TOKEN_EXP=7d
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>

# ── Optional ──────────────────────────────────────────────
PENDING_BOOKING_TTL_MINUTES=30
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=CineMatrix <no-reply@yourdomain.com>
