# Server
PORT=8000
MONGO_URI=mongodb://localhost:27017/cinematrix

# CORS (must match the two frontends)
FRONTEND_CLIENT=http://localhost:5173
FRONTEND_ADMIN=http://localhost:5174

# JWT
ACCESS_TOKEN_SECRET=replace-me-access-secret
REFRESH_TOKEN_SECRET=replace-me-refresh-secret
ACCESS_TOKEN_EXP=1d
REFRESH_TOKEN_EXP=7d

# Redis (seat locks). Optional for boot; bookings need it to lock seats.
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (CLOUDINARY_URL takes precedence over the three separate values)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# TMDB (optional; enables the admin movie import tools)
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# SMTP (optional; booking status emails are skipped when SMTP_HOST is unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CineMatrix <no-reply@cinematrix.app>

# Dev seeder defaults
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_OWNER_EMAIL=owner@gmail.com
SEED_OWNER_PASSWORD=Owner@1234
SEED_STAFF_EMAIL=staff@gmail.com
SEED_STAFF_PASSWORD=Staff@1234
SEED_CUSTOMER_EMAIL=customer@gmail.com
SEED_CUSTOMER_PASSWORD=Customer@1234
